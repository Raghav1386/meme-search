# MemeSearch Ingestion Service Environment

PORT=4001
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Ingestion Worker Settings
INGESTION_WORKER_CONCURRENCY=2

# Media Acquisition Safety Limits
MEDIA_REQUEST_TIMEOUT_MS=10000
MEDIA_MAX_BYTES=10485760

# Media Inspection Limits
MEDIA_MIN_WIDTH=32
MEDIA_MIN_HEIGHT=32
MEDIA_MAX_WIDTH=10000
MEDIA_MAX_HEIGHT=10000
MEDIA_MAX_VIDEO_DURATION_MS=300000

# Image Normalization
IMAGE_NORMALIZE_MAX_WIDTH=1024
IMAGE_NORMALIZE_MAX_HEIGHT=1024
IMAGE_NORMALIZE_JPEG_QUALITY=85

# Media Storage (Persistent Canonical Artifacts)
MEDIA_STORAGE_ENABLED=false
MEDIA_STORAGE_PROVIDER=s3
MEDIA_STORAGE_BUCKET=my-meme-bucket
MEDIA_STORAGE_REGION=us-east-1
# MEDIA_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
# MEDIA_STORAGE_ACCESS_KEY_ID=
# MEDIA_STORAGE_SECRET_ACCESS_KEY=
# MEDIA_STORAGE_PUBLIC_BASE_URL=https://cdn.my-meme.com
MEDIA_STORAGE_REQUEST_TIMEOUT_MS=10000
MEDIA_STORAGE_MAX_UPLOAD_BYTES=10485760

# Phase 4 - Discovery Database & Integration Boundary
DISCOVERY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/meme_discovery?sslmode=require
PYTHON_SERVICE_URL=http://127.0.0.1:8000
