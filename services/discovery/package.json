{
  "name": "meme-search-discovery",
  "version": "1.0.0",
  "description": "Discovery Service for MemeSearch. Responsible for finding, scoring, and enqueueing new meme candidates.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "discover": "node src/run-once.js",
    "collect:ravi-samay-latent": "node src/scripts/manualTopicCollector.js",
    "collect:ravi-samay-latent:enqueue": "node src/scripts/manualTopicCollector.js --enqueue"
  },
  "dependencies": {
    "apify-client": "^2.25.0",
    "bullmq": "^6.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.11.0",
    "sharp": "^0.35.3",
    "winston": "^3.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
