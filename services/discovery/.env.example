PORT=4000
REDIS_URL=rediss://default:YOUR_PASSWORD@your-upstash-host:6379
DISCOVERY_ENABLED=true
DISCOVERY_RUN_MODE=test

# Phase 4 - Discovery Database & Scheduler
DISCOVERY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/meme_discovery?sslmode=require
DISCOVERY_SCHEDULE_ENABLED=false
DISCOVERY_INTERVAL_MS=3600000

# Trend Scoring Rules
TREND_ENGAGEMENT_WEIGHT=0.6
TREND_FRESHNESS_WEIGHT=0.4
TREND_FRESHNESS_HALFLIFE_HOURS=48

# Candidate Filtering & Ranking Rules
# TREND_MIN_SCORE: Controls the minimum quality threshold (0-100) required to send candidate to the ingestion queue.
TREND_MIN_SCORE=30
# TREND_MAX_CANDIDATES_PER_RUN: Limits the maximum number of top-ranked candidates allowed per discovery run to limit queue pressure.
TREND_MAX_CANDIDATES_PER_RUN=100

# Reddit Source
DISCOVERY_REDDIT_SOURCE_ENABLED=false
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=MemeSearch/1.0.0
REDDIT_SUBREDDITS=memes,dankmemes,funny
REDDIT_LIMIT=25
REDDIT_REQUEST_TIMEOUT_MS=10000

# YouTube Source
DISCOVERY_YOUTUBE_SOURCE_ENABLED=false
YOUTUBE_API_KEY=your_api_key_here
YOUTUBE_CHANNEL_IDS=UCxyz123,UCabc456
YOUTUBE_SEARCH_QUERY=memes
YOUTUBE_LIMIT=25
YOUTUBE_REQUEST_TIMEOUT_MS=10000
